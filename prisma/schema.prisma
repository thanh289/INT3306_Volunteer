// Defines the database schema for all models in the application.
// prisma/schema.prisma
// update: add indexes for optimization (and looke like we don't need to add index for unique fields)

datasource db {
    provider = "mongodb"
    // Connection URLs are no longer supported in schema files.
    // Move your connection URL to prisma.config.ts and pass it to the PrismaClient
    // (using `adapter` for a direct database connection or `accelerateUrl` for Accelerate).
    // See: https://pris.ly/d/config-datasource and https://pris.ly/d/prisma7-client-config

    // this is a common warning for new version of prisma
    // but this one still work with mongodb? so just let it be like this
    url = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum Role {
    VOLUNTEER
    EVENT_MANAGER
    ADMIN
}

enum EventCategory {
    ENVIRONMENT
    EDUCATION
    HEALTHCARE
    COMMUNITY
}

enum RegistrationStatus {
    PENDING
    APPROVED
    REJECTED
    COMPLETED
}

enum PostStatus {
    PENDING
    APPROVED
    REJECTED
}

enum EventStatus {
    PENDING_APPROVAL
    PUBLISHED
    REJECTED
}

enum Gender {
    MALE
    FEMALE
}

enum UserStatus {
    ACTIVE
    LOCKED
}

model PushSubscription {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    endpoint String @unique
    p256dh   String // Public key for encryption
    auth     String // Auth secret for encryption

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
}

// API generated is prisma.user
model User {
    id           String     @id @default(auto()) @map("_id") @db.ObjectId
    name         String?
    email        String     @unique
    phone        String? //optional
    address      String?
    dateOfBirth  DateTime?
    gender       Gender?
    passwordHash String
    role         Role       @default(VOLUNTEER)
    status       UserStatus @default(ACTIVE)
    imageUrl     String?
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt

    // an user can registry multiple event and have multiple post
    registrations Registration[]
    posts         Post[]
    postLikes     PostLike[]
    postComments  PostComment[]

    createdEvents      Event[]             @relation("EventCreator")
    notifications      Notification[]
    passwordResetToken PasswordResetToken?
    pushSubscriptions  PushSubscription[]
    interestedEvents   InterestedEvent[]
    managedEvents      EventManager[]

    @@index([role])
    @@index([status])
    @@index([createdAt])
}

model Event {
    id            String        @id @default(auto()) @map("_id") @db.ObjectId
    title         String
    description   String
    location      String
    imageUrl      String?
    startDateTime DateTime
    endDateTime   DateTime
    maxAttendees  Int
    category      EventCategory @default(COMMUNITY)
    status        EventStatus   @default(PENDING_APPROVAL)
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt

    // Post moderation setting
    requirePostApproval Boolean @default(false)

    // Soft delete fields
    isDeleted     Boolean   @default(false)
    deletedAt     DateTime?
    deletedBy     String?   @db.ObjectId
    deletedByRole Role?

    // Cancel fields (for temporary cancellation with restore option)
    isCancelled     Boolean   @default(false)
    cancelledAt     DateTime?
    cancelledBy     String?   @db.ObjectId
    cancelledByRole Role?
    cancelReason    String?

    // this event created by manager
    creatorId String @db.ObjectId
    creator   User   @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)

    // an event can has multiple user and post
    registrations   Registration[]
    posts           Post[]
    interestedBy    InterestedEvent[]
    eventManagers   EventManager[]

    @@index([status, startDateTime])
    @@index([creatorId, createdAt])
    @@index([category, startDateTime])
    @@index([status, category])
    @@index([startDateTime])
    @@index([isDeleted])
    @@index([isCancelled])
}

model Registration {
    id        String             @id @default(auto()) @map("_id") @db.ObjectId
    createdAt DateTime           @default(now())
    status    RegistrationStatus @default(PENDING)

    // Which user
    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id])

    // Which event
    eventId String @db.ObjectId
    event   Event  @relation(fields: [eventId], references: [id])

    // an user can only registry an event once
    @@unique([userId, eventId])
    @@index([userId, status])
    @@index([eventId, status])
    @@index([status, createdAt])
}

model Post {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    content   String
    imageUrl  String?
    createdAt DateTime @default(now())

    // Post approval status
    postStatus PostStatus @default(APPROVED)
    reviewedAt DateTime?
    reviewedBy String?    @db.ObjectId

    // Pin post feature
    isPinned Boolean  @default(false)
    pinnedAt DateTime?
    pinnedBy String?  @db.ObjectId

    // Soft delete fields
    isDeleted     Boolean   @default(false)
    deletedAt     DateTime?
    deletedBy     String?   @db.ObjectId
    deletedByRole Role?

    eventId String @db.ObjectId
    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

    authorId String @db.ObjectId
    author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

    likes    PostLike[]
    comments PostComment[]

    @@index([eventId, createdAt])
    @@index([isDeleted])
}

model PostLike {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    createdAt DateTime @default(now())

    // Which user liked
    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Which post they liked
    postId String @db.ObjectId
    post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

    // A user can only like a post once
    @@unique([userId, postId])
    @@index([postId])
    @@index([userId])
}

model PostComment {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    content   String
    createdAt DateTime @default(now())

    // Soft delete fields
    isDeleted     Boolean   @default(false)
    deletedAt     DateTime?
    deletedBy     String?   @db.ObjectId
    deletedByRole Role?

    // Which user commented
    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Which post they commented on
    postId String @db.ObjectId
    post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

    @@index([postId, createdAt])
    @@index([userId])
    @@index([isDeleted])
}

model Notification {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    message   String
    href      String? // link to direct when click the notification
    isRead    Boolean  @default(false)
    createdAt DateTime @default(now())

    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, isRead, createdAt])
}

model PasswordResetToken {
    id      String   @id @default(auto()) @map("_id") @db.ObjectId
    token   String   @unique
    expires DateTime

    // 1 user will just have 1 token
    userId String @unique @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([expires])
}

model InterestedEvent {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    createdAt DateTime @default(now())

    // Which user is interested
    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Which event they're interested in
    eventId String @db.ObjectId
    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

    // A user can only mark an event as interested once
    @@unique([userId, eventId])
    @@index([userId, createdAt])
    @@index([eventId])
}

model EventManager {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    createdAt DateTime @default(now())

    // Which user is a manager
    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Which event they manage
    eventId String @db.ObjectId
    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

    // Who assigned this manager (creator or admin)
    assignedBy String @db.ObjectId

    // A user can only be a manager of an event once
    @@unique([userId, eventId])
    @@index([userId])
    @@index([eventId])
}
