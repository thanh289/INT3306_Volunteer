// Defines the database schema for all models in the application.
// prisma/schema.prisma

datasource db {
    provider = "mongodb"
    // Move connection URL to prisma.config.ts and pass it to the PrismaClient
    url = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

enum Role {
    VOLUNTEER
    EVENT_MANAGER
    ADMIN
}

enum EventCategory {
    ENVIRONMENT
    EDUCATION
    HEALTHCARE
    COMMUNITY
}

enum RegistrationStatus {
    PENDING
    APPROVED
    REJECTED
    COMPLETED
}

enum PostStatus {
    PENDING
    APPROVED
    REJECTED
}

enum EventStatus {
    PENDING_APPROVAL
    PUBLISHED
    REJECTED
}

enum Gender {
    MALE
    FEMALE
}

enum UserStatus {
    ACTIVE
    LOCKED
}

model PushSubscription {
    id     String @id @default(auto()) @map("_id") @db.ObjectId
    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    endpoint String @unique
    p256dh   String // Public key for encryption
    auth     String // Auth secret for encryption

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
}

// API generated is prisma.user
model User {
    id           String     @id @default(auto()) @map("_id") @db.ObjectId
    name         String?
    email        String     @unique
    phone        String?
    address      String?
    dateOfBirth  DateTime?
    gender       Gender?
    passwordHash String
    role         Role       @default(VOLUNTEER)
    status       UserStatus @default(ACTIVE)
    imageUrl     String?
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt

    registrations Registration[]
    posts         Post[]
    postLikes     PostLike[]
    postComments  PostComment[]

    createdEvents           Event[]             @relation("EventCreator")
    notifications           Notification[]
    passwordResetToken      PasswordResetToken?
    pushSubscriptions       PushSubscription[]
    interestedEvents        InterestedEvent[]
    managedEvents           EventManager[]
    invitationsReceived     EventInvitation[]   @relation("EventInvitationsReceived")
    invitationsSent         EventInvitation[]   @relation("EventInvitationsSent")

    @@index([role])
    @@index([status])
    @@index([createdAt])
}

model Event {
    id            String        @id @default(auto()) @map("_id") @db.ObjectId
    title         String
    description   String
    location      String
    imageUrl      String?
    startDateTime DateTime
    endDateTime   DateTime
    maxAttendees  Int
    category      EventCategory @default(COMMUNITY)
    status        EventStatus   @default(PENDING_APPROVAL)
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt

    requirePostApproval Boolean @default(false)

    requiresRegistrationForm Boolean @default(false)

    // Soft delete fields
    isDeleted     Boolean   @default(false)
    deletedAt     DateTime?
    deletedBy     String?   @db.ObjectId
    deletedByRole Role?

    isCancelled     Boolean   @default(false)
    cancelledAt     DateTime?
    cancelledBy     String?   @db.ObjectId
    cancelledByRole Role?
    cancelReason    String?

    creatorId String @db.ObjectId
    creator   User   @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)

    registrations         Registration[]
    posts                 Post[]
    interestedBy          InterestedEvent[]
    eventManagers         EventManager[]
    registrationQuestions RegistrationQuestion[]
    invitations           EventInvitation[]

    @@index([status, startDateTime])
    @@index([creatorId, createdAt])
    @@index([category, startDateTime])
    @@index([status, category])
    @@index([startDateTime])
    @@index([isDeleted])
    @@index([isCancelled])
}

model RegistrationQuestion {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    question  String
    isRequired Boolean @default(true)
    order     Int
    createdAt DateTime @default(now())

    eventId String @db.ObjectId
    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

    answers RegistrationAnswer[]

    @@index([eventId, order])
}

model RegistrationAnswer {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    answer    String
    createdAt DateTime @default(now())

    questionId String               @db.ObjectId
    question   RegistrationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

    registrationId String       @db.ObjectId
    registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

    @@index([questionId])
    @@index([registrationId])
}

model Registration {
    id        String             @id @default(auto()) @map("_id") @db.ObjectId
    createdAt DateTime           @default(now())
    status    RegistrationStatus @default(PENDING)

    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id])

    eventId String @db.ObjectId
    event   Event  @relation(fields: [eventId], references: [id])

    answers RegistrationAnswer[]

    @@unique([userId, eventId])
    @@index([userId, status])
    @@index([eventId, status])
    @@index([status, createdAt])
}

model Post {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    content   String
    imageUrl  String?
    createdAt DateTime @default(now())

    postStatus PostStatus @default(APPROVED)
    reviewedAt DateTime?
    reviewedBy String?    @db.ObjectId

    isPinned Boolean  @default(false)
    pinnedAt DateTime?
    pinnedBy String?  @db.ObjectId

    // Soft delete fields
    isDeleted     Boolean   @default(false)
    deletedAt     DateTime?
    deletedBy     String?   @db.ObjectId
    deletedByRole Role?

    eventId String @db.ObjectId
    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

    authorId String @db.ObjectId
    author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

    likes    PostLike[]
    comments PostComment[]

    @@index([eventId, createdAt])
    @@index([isDeleted])
}

model PostLike {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    createdAt DateTime @default(now())

    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    postId String @db.ObjectId
    post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

    @@unique([userId, postId])
    @@index([postId])
    @@index([userId])
}

model PostComment {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    content   String
    createdAt DateTime @default(now())

    // Soft delete fields
    isDeleted     Boolean   @default(false)
    deletedAt     DateTime?
    deletedBy     String?   @db.ObjectId
    deletedByRole Role?

    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    postId String @db.ObjectId
    post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

    @@index([postId, createdAt])
    @@index([userId])
    @@index([isDeleted])
}

model Notification {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    message   String
    href      String?
    isRead    Boolean  @default(false)
    createdAt DateTime @default(now())

    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, isRead, createdAt])
}

model PasswordResetToken {
    id      String   @id @default(auto()) @map("_id") @db.ObjectId
    token   String   @unique
    expires DateTime

    userId String @unique @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([expires])
}

model InterestedEvent {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    createdAt DateTime @default(now())

    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    eventId String @db.ObjectId
    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

    @@unique([userId, eventId])
    @@index([userId, createdAt])
    @@index([eventId])
}

model EventManager {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    createdAt DateTime @default(now())

    userId String @db.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    eventId String @db.ObjectId
    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

    assignedBy String @db.ObjectId

    @@unique([userId, eventId])
    @@index([userId])
    @@index([eventId])
}

model EventInvitation {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    createdAt DateTime @default(now())

    eventId String @db.ObjectId
    event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

    invitedUserId String @db.ObjectId
    invitedUser   User   @relation("EventInvitationsReceived", fields: [invitedUserId], references: [id], onDelete: Cascade)

    invitedBy String @db.ObjectId
    inviter   User   @relation("EventInvitationsSent", fields: [invitedBy], references: [id], onDelete: Cascade)

// An user can be invited multiple times by many users but one user can only invite another one time.
    @@unique([eventId, invitedUserId, invitedBy])
    @@index([invitedUserId, createdAt])
    @@index([eventId])
    @@index([invitedBy])
}
